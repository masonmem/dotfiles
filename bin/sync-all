#!/usr/bin/env bash
# sync-all — one command to bring this Mac up to date with the latest
# from every repo that drives its environment.
#
# Currently:
#   * dotfiles-sync     ~/dotfiles    machine env (Brewfile, zsh, stow)
#   * ai-config-sync    ~/code/ai-sync  AI brain (skills, instructions, MCP)
#
# Safe to run anywhere. Same command on every Mac, regardless of where
# the change you're pulling originated. Idempotent — each child script
# bails on a dirty working tree to avoid trampling local edits.
#
# Usage:
#   sync-all           # pull everything
#   sync-all dotfiles  # just dotfiles
#   sync-all ai-sync   # just ai-sync

set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
AI_SYNC_REPO="${AI_CONFIG:-$HOME/code/ai-sync}"
TARGET="${1:-all}"

run_dotfiles() {
  if [[ -x "$DOTFILES/bin/dotfiles-sync" ]]; then
    "$DOTFILES/bin/dotfiles-sync"
  else
    echo "[sync-all] skip dotfiles: $DOTFILES/bin/dotfiles-sync not found"
  fi
}

run_ai_config() {
  if [[ -x "$AI_SYNC_REPO/bin/ai-config-sync" ]]; then
    "$AI_SYNC_REPO/bin/ai-config-sync"
  else
    echo "[sync-all] skip ai-sync: $AI_SYNC_REPO/bin/ai-config-sync not found"
  fi
}

case "$TARGET" in
  all)         run_dotfiles; echo; run_ai_config ;;
  dotfiles)    run_dotfiles ;;
  ai-sync|ai-config) run_ai_config ;;
  *)           echo "usage: sync-all [all|dotfiles|ai-sync]" >&2; exit 2 ;;
esac

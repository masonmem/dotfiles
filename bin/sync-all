#!/usr/bin/env bash
# sync-all — bring this machine up to date with every repo that drives it:
#
#   dotfiles-sync    ~/dotfiles        packages, shell, configs (this repo)
#   ai-config-sync   ~/code/ai-sync    skills, agent instructions, MCP
#
# Same command on every host, whichever machine a change came from.
#
# Usage: sync-all [all|dotfiles|ai-sync]
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
AI_SYNC="${AI_CONFIG:-$HOME/code/ai-sync}"

run_dotfiles() {
  "$DOTFILES/bin/dotfiles-sync"
}

run_ai_sync() {
  if [[ -x "$AI_SYNC/bin/ai-config-sync" ]]; then
    "$AI_SYNC/bin/ai-config-sync"
  else
    echo "[sync-all] skipping ai-sync: $AI_SYNC/bin/ai-config-sync not found"
  fi
}

case "${1:-all}" in
  all)               run_dotfiles; echo; run_ai_sync ;;
  dotfiles)          run_dotfiles ;;
  ai-sync|ai-config) run_ai_sync ;;
  *) echo "usage: sync-all [all|dotfiles|ai-sync]" >&2; exit 2 ;;
esac

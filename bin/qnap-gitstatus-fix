#!/usr/bin/env bash
# qnap-gitstatus-fix — QNAP (hyperion) workarounds for powerlevel10k's
# gitstatus. Idempotent; bootstrap-shell runs it after moving the p10k pin.
#
#   1. Entware's zsh can't enable MONITOR (job control), and
#      gitstatus.plugin.zsh aborts on `setopt monitor || return`. Patch that
#      line to tolerate the failure.
#   2. gitstatusd needs mkfifo, which QNAP's busybox lacks. It must exist at
#      ~/bin/mkfifo (install steps: README § QNAP).
set -euo pipefail

PLUGIN="${ZSH:-$HOME/.oh-my-zsh}/custom/themes/powerlevel10k/gitstatus/gitstatus.plugin.zsh"
OLD='      setopt monitor || return'
NEW='      setopt monitor 2>/dev/null || true  # QNAP-compat: zsh build lacks MONITOR'

if [[ ! -f "$PLUGIN" ]]; then
  echo "gitstatus plugin: not found at $PLUGIN"
elif grep -qF "$NEW" "$PLUGIN"; then
  echo "gitstatus plugin: already patched"
elif grep -qxF "$OLD" "$PLUGIN"; then
  # Exact whole-line replacement without regex quoting (and without python,
  # which Entware hosts may not have).
  tmp="$(mktemp)"
  while IFS= read -r l || [[ -n "$l" ]]; do
    if [[ "$l" == "$OLD" ]]; then printf '%s\n' "$NEW"; else printf '%s\n' "$l"; fi
  done < "$PLUGIN" > "$tmp"
  cat "$tmp" > "$PLUGIN" && rm -f "$tmp"
  echo "gitstatus plugin: patched"
else
  echo "gitstatus plugin: nothing to patch (line not found — was upstream rewritten?)"
fi

if [[ -x "$HOME/bin/mkfifo" ]]; then
  echo "$HOME/bin/mkfifo: present"
else
  echo "$HOME/bin/mkfifo: MISSING — see README § QNAP for how to install it."
fi

#!/usr/bin/env bash
# dotfiles-sync — bring this machine in line with the repo. Idempotent, and the
# same command on every host no matter where a change was made. Usually run
# via `sync-all`, which also syncs ai-sync.
#
#   1. pull   git fast-forward. Skipped with a warning (the rest still runs)
#             when there are uncommitted changes, local commits have diverged,
#             or the network is down. Re-runs itself if this script changed.
#   2. brew   Brewfile, then <package>/Brewfile for each selected package, then
#             Brewfile.d/<host>.Brewfile. --no-upgrade: installs missing only.
#   3. pipx   <package>/pipx-tools.txt for each selected package (missing only).
#   4. shell  bootstrap-shell: oh-my-zsh / p10k / plugins → shell-clones.txt pins.
#   5. link   `stow --no-folding -R` each selected package (a built-in
#             equivalent on hosts without stow, e.g. QNAP), then remove
#             symlinks left pointing at files deleted from the repo.
#
# The selected packages come from ~/.config/dotfiles/packages (untracked,
# written by install.sh). That file is what keeps personal packages off the
# work machine, so there is deliberately no default.
#
# Options:
#   --backup-conflicts  move a real file that blocks a link to <file>.pre-dotfiles
#                       (install.sh uses this on a fresh machine)
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
MANIFEST="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/packages"
NON_PACKAGES=" bin docs scripts templates tests Brewfile.d site "   # site/ = local docs build

BACKUP_CONFLICTS=0
for arg in "$@"; do
  case "$arg" in
    --backup-conflicts) BACKUP_CONFLICTS=1 ;;
    -h|--help) sed -n '2,/^set -e/{/^set -e/d;s/^# \{0,1\}//;p;}' "$0"; exit 0 ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done

log()  { printf '\033[36m[dotfiles-sync]\033[0m %s\n' "$*"; }
warn() { printf '\033[33m[dotfiles-sync] WARN:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[31m[dotfiles-sync] ERROR:\033[0m %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# launchd/cron start with a minimal PATH; find Homebrew (and its stow) there.
have brew || PATH="$PATH:/opt/homebrew/bin"

cd "$DOTFILES"

# ── 1. pull ─────────────────────────────────────────────────────────────────
pull() {
  if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
    warn "uncommitted changes in $DOTFILES — skipping pull (commit + push, or stash):"
    git status --short --untracked-files=no >&2
    return 0
  fi
  if ! git rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
    warn "branch '$(git rev-parse --abbrev-ref HEAD)' has no upstream — skipping pull"
    return 0
  fi
  log "fetching…"
  if ! git fetch --quiet; then
    warn "git fetch failed (offline?) — skipping pull"
    return 0
  fi
  local ahead behind
  read -r ahead behind < <(git rev-list --left-right --count 'HEAD...@{u}')
  if (( behind == 0 )); then
    log "up to date ($(git rev-parse --short HEAD))"
  elif (( ahead == 0 )); then
    log "pulling $behind new commit(s)"
    if ! git merge --ff-only --quiet '@{u}'; then
      warn "fast-forward failed (see above) — continuing without the new commits"
    fi
  else
    warn "local and upstream have diverged — skipping pull (rebase or merge by hand)"
  fi
  if (( ahead > 0 )); then
    log "$ahead local commit(s) not pushed yet"
  fi
}

if [[ -z "${_DOTFILES_SYNC_PULLED:-}" ]]; then
  before=$(git rev-parse HEAD)
  pull
  if [[ "$(git rev-parse HEAD)" != "$before" ]] && ! git diff --quiet "$before" HEAD -- bin/dotfiles-sync; then
    log "dotfiles-sync itself changed — continuing with the new version"
    _DOTFILES_SYNC_PULLED=1 exec "$DOTFILES/bin/dotfiles-sync" "$@"
  fi
fi

# ── packages ────────────────────────────────────────────────────────────────
[[ -r "$MANIFEST" ]] || die "no package list at $MANIFEST — run: $DOTFILES/install.sh <personal|work|minimal>"

is_package() { [[ -d "$DOTFILES/$1" && "$NON_PACKAGES" != *" $1 "* && "$1" != .* ]]; }

PACKAGES=()
while IFS= read -r line || [[ -n "$line" ]]; do
  line="${line%%#*}"
  line="${line//[[:space:]]/}"
  [[ -n "$line" ]] || continue
  if is_package "$line"; then
    PACKAGES+=("$line")
  else
    warn "ignoring '$line' in $MANIFEST: not a package in $DOTFILES"
  fi
done < "$MANIFEST"
(( ${#PACKAGES[@]} )) || die "$MANIFEST lists no packages"
log "packages: ${PACKAGES[*]}"

unselected=()
for dir in "$DOTFILES"/*/; do
  dir="${dir%/}"; dir="${dir##*/}"
  if is_package "$dir" && [[ " ${PACKAGES[*]} " != *" $dir "* ]]; then
    unselected+=("$dir")
  fi
done
if (( ${#unselected[@]} )); then
  log "not enabled on this host: ${unselected[*]} (edit $MANIFEST to change)"
fi

# ── 2. brew ─────────────────────────────────────────────────────────────────
brew_bundle() {
  log "brew bundle ${1#"$DOTFILES"/}"
  # Output stays visible: bundle can take minutes and its errors matter.
  if ! brew bundle --no-upgrade --file="$1"; then
    # e.g. Homebrew not yet supporting a macOS beta ("unknown macOS version").
    warn "brew bundle failed for ${1#"$DOTFILES"/} — continuing. Re-run: brew bundle --no-upgrade --file=$1"
  fi
}

# Host name for Brewfile.d/<host>.Brewfile. On macOS, `hostname` can follow
# whatever DHCP hands out, so ask for the configured names instead.
if have scutil; then
  HOST="$(scutil --get HostName 2>/dev/null || scutil --get LocalHostName 2>/dev/null || hostname -s)"
else
  HOST="$(hostname -s 2>/dev/null || uname -n)"
fi
HOST="$(printf '%s' "${HOST%%.*}" | tr '[:upper:]' '[:lower:]')"
log "host: $HOST"

if have brew; then
  brew_bundle "$DOTFILES/Brewfile"
  for pkg in "${PACKAGES[@]}"; do
    if [[ -f "$DOTFILES/$pkg/Brewfile" ]]; then brew_bundle "$DOTFILES/$pkg/Brewfile"; fi
  done
  if [[ -f "$DOTFILES/Brewfile.d/$HOST.Brewfile" ]]; then
    brew_bundle "$DOTFILES/Brewfile.d/$HOST.Brewfile"
  fi
else
  log "brew not found — skipping Brewfiles (expected on Linux / QNAP)"
fi

# ── 3. pipx ─────────────────────────────────────────────────────────────────
normalize() { tr '[:upper:]' '[:lower:]' | sed 's/[_.]/-/g'; }   # PEP 503: Foo_Bar == foo-bar

pipx_sync() {
  local list="$1" installed line name spec
  installed=" $(pipx list --short 2>/dev/null | awk '{print $1}' | normalize | tr '\n' ' ') "
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    read -r name spec _ <<<"$line" || true
    [[ -n "${name:-}" ]] || continue
    if [[ "$installed" == *" $(printf '%s' "$name" | normalize) "* ]]; then continue; fi
    log "pipx install ${spec:-$name}"
    if ! pipx install "${spec:-$name}"; then warn "pipx install $name failed — continuing"; fi
  done < "$list"
}

for pkg in "${PACKAGES[@]}"; do
  list="$DOTFILES/$pkg/pipx-tools.txt"
  [[ -f "$list" ]] || continue
  if have pipx; then
    pipx_sync "$list"
  else
    warn "pipx not found — skipping ${list#"$DOTFILES"/}"
  fi
done

# ── 4. shell framework ──────────────────────────────────────────────────────
log "converging shell framework (oh-my-zsh / p10k / plugins → shell-clones.txt)…"
if ! "$DOTFILES/bin/bootstrap-shell"; then
  warn "bootstrap-shell reported a problem — continuing"
fi

# ── 5. link ─────────────────────────────────────────────────────────────────
# Stow's ignore rules, reimplemented for the built-in linker and for
# --backup-conflicts: a pattern without "/" matches a basename; one with "/"
# matches the package-relative path. <package>/.stow-local-ignore replaces
# the defaults.
DEFAULT_IGNORES='\.DS_Store
\.git
\.gitignore
\.gitmodules
.+~
#.*#
^/README.*
^/LICENSE.*
^/COPYING'

package_files() {   # <pkg> — print package-relative paths of files to link
  local root="$DOTFILES/$1" rules seg="" path="" pat rel base
  if [[ -f "$root/.stow-local-ignore" ]]; then
    rules="$(sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^#/d' -e 's/[[:space:]][[:space:]]*#.*//' -e 's/\\#/#/g' -e '/^$/d' "$root/.stow-local-ignore")"
  else
    rules="$DEFAULT_IGNORES"
  fi
  rules="$rules"$'\n''^/\.stow-local-ignore$'
  while IFS= read -r pat; do
    [[ -n "$pat" ]] || continue
    if [[ "$pat" == */* ]]; then path="${path:+$path|}$pat"; else seg="${seg:+$seg|}$pat"; fi
  done <<<"$rules"
  (cd "$root" && find . \( -type f -o -type l \) | sed 's|^\./||') | while IFS= read -r rel; do
    base="${rel##*/}"
    if [[ -n "$seg" && "$base" =~ ^($seg)$ ]]; then continue; fi
    if [[ -n "$path" && "/$rel" =~ (^|/)($path)(/|$) ]]; then continue; fi
    # a directory component matching a segment rule hides everything under it
    if [[ -n "$seg" && "/$rel" =~ /($seg)/ ]]; then continue; fi
    printf '%s\n' "$rel"
  done
}

backup_conflicts() {   # <pkg>
  local rel dest
  while IFS= read -r rel; do
    dest="$HOME/$rel"
    if [[ -e "$dest" && ! -L "$dest" && ! -d "$dest" ]]; then
      mv "$dest" "$dest.pre-dotfiles"
      log "moved existing ~/$rel → ~/$rel.pre-dotfiles"
    fi
  done < <(package_files "$1")
}

points_into_repo() {   # <symlink> — absolute (built-in linker) or relative (stow)
  case "$(readlink "$1")" in
    "$DOTFILES"/*|"${DOTFILES##*/}"/*|*/"${DOTFILES##*/}"/*) return 0 ;;
  esac
  return 1
}

link_package() {   # <pkg> — `stow --no-folding` equivalent, absolute links
  local rel dest rc=0
  while IFS= read -r rel; do
    dest="$HOME/$rel"
    if [[ -L "$dest" ]] && ! points_into_repo "$dest"; then
      warn "$dest is a symlink to somewhere else — not replacing it"
      rc=1
      continue
    elif [[ -e "$dest" && ! -L "$dest" ]]; then
      warn "$dest exists and is not a symlink — not replacing it"
      rc=1
      continue
    fi
    mkdir -p "$(dirname "$dest")"
    ln -sfn "$DOTFILES/$1/$rel" "$dest"
  done < <(package_files "$1")
  return "$rc"
}

prune_stale_links() {   # remove broken symlinks that point into the repo
  local link dirs=("$HOME/.config" "$HOME/bin")
  while IFS= read -r link; do
    if points_into_repo "$link"; then
      rm -f "$link"
      log "removed stale link ~/${link#"$HOME"/}"
    fi
  done < <(
    find "$HOME" -maxdepth 1 -type l ! -exec test -e {} \; -print 2>/dev/null
    for d in "${dirs[@]}"; do
      if [[ -d "$d" ]]; then find "$d" -type l ! -exec test -e {} \; -print 2>/dev/null; fi
    done
  )
}

if (( BACKUP_CONFLICTS )); then
  for pkg in "${PACKAGES[@]}"; do backup_conflicts "$pkg"; done
fi

FAILED=()
if have stow; then
  log "linking with stow…"
  for pkg in "${PACKAGES[@]}"; do
    if ! stow --no-folding -R --ignore='\.DS_Store' -d "$DOTFILES" -t "$HOME" "$pkg"; then
      FAILED+=("$pkg")
    fi
  done
else
  log "stow not found — linking with the built-in linker"
  for pkg in "${PACKAGES[@]}"; do
    if ! link_package "$pkg"; then FAILED+=("$pkg"); fi
  done
fi
prune_stale_links

# One-time cleanup (2026-09): before ollama/.stow-local-ignore existed, the
# ollama package linked these into $HOME. Remove only links into this repo.
for legacy in "$HOME/launchagents" "$HOME/modelfiles" "$HOME/bin/install-ollama.sh"; do
  if [[ -L "$legacy" && "$(readlink "$legacy")" == *"${DOTFILES##*/}/ollama/"* ]]; then
    rm -f "$legacy"; log "removed legacy link $legacy"
  elif [[ -d "$legacy" && ! -L "$legacy" ]]; then
    for l in "$legacy"/*; do
      if [[ -L "$l" && "$(readlink "$l")" == *"${DOTFILES##*/}/ollama/"* ]]; then rm -f "$l"; fi
    done
    if rmdir "$legacy" 2>/dev/null; then log "removed legacy dir $legacy"; fi
  fi
done

if (( ${#FAILED[@]} )); then
  die "could not link: ${FAILED[*]} — resolve the conflicts above (or re-run with --backup-conflicts) and re-run"
fi
log "done."

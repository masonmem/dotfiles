#!/usr/bin/env bash
# dotfiles-sync — pull latest dotfiles, install any new brew packages, re-stow.
# Idempotent and direction-agnostic — same command on every Mac, regardless of
# where the change you're pulling originated. Bails on a dirty working tree
# so it won't trample local edits.
#
# Prefer `sync-all` (calls this + ai-config-sync) for the common case of
# "bring everything up to date".
#
# Triggers:
#   - Manual:  `dotfiles-sync`
#   - Timer:   sh.user.sync-all launchd agent (opt-in; see README).
#
# Conservative by default:
#   - `git pull --ff-only`        (never rebases or auto-merges)
#   - `brew bundle --no-upgrade`  (installs missing, does NOT upgrade existing)
#   - `stow --no-folding -R`      (re-link; safe even if already linked)
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

log()  { printf '\033[36m[dotfiles-sync]\033[0m %s\n' "$*"; }
warn() { printf '\033[33m[dotfiles-sync] WARN:\033[0m %s\n' "$*" >&2; }

cd "$DOTFILES"

# Bail loudly if dirty — we won't trample local edits.
if ! git diff --quiet HEAD || ! git diff --quiet --cached; then
  log "working tree dirty; refusing to sync. Commit or stash first:"
  git status --short
  exit 1
fi

log "fetching origin…"
git fetch --quiet origin

local_rev=$(git rev-parse HEAD)
remote_rev=$(git rev-parse '@{u}')
if [[ "$local_rev" == "$remote_rev" ]]; then
  log "already up to date ($local_rev)"
else
  log "pulling $local_rev → $remote_rev"
  git pull --ff-only --quiet
fi

# brew_bundle <file> <label> — run a Brewfile, tolerating failure. brew bundle
# can hard-error for reasons unrelated to our packages (e.g. Homebrew not yet
# supporting a macOS beta: "unknown or unsupported macOS version: :dunno"); under
# `set -e` that would abort the whole sync, skipping stow + ai-config. We log and
# continue instead — the rest of sync is more important than installing a formula.
brew_bundle() {
  local file="$1" label="$2"
  log "brew bundle ($label)…"
  if ! brew bundle --no-upgrade --file="$file" >/dev/null 2>&1; then
    warn "brew bundle ($label) failed — continuing without it."
    warn "  (re-run \`brew bundle --file=$file\` to see why; common on an"
    warn "   unsupported macOS beta until Homebrew catches up.)"
  fi
}

if command -v brew >/dev/null 2>&1; then
  brew_bundle "$DOTFILES/Brewfile" "install missing only"

  # Per-host extras: Brewfile.d/<host>.Brewfile (e.g. solaris server formulae)
  HOST_BREWFILE="$DOTFILES/Brewfile.d/$(hostname -s | tr '[:upper:]' '[:lower:]').Brewfile"
  if [[ -f "$HOST_BREWFILE" ]]; then
    brew_bundle "$HOST_BREWFILE" "host extras: ${HOST_BREWFILE##*/}"
  fi
else
  log "brew not found — skipping brew bundle (expected on hyperion / Linux)"
fi

# Converge the git-clone shell framework (oh-my-zsh, p10k, zsh plugins) to the
# pins in shell-clones.txt. Runs on EVERY host (only needs git) — this is what
# stops a clone silently rotting years out of date. Cheap: bootstrap-shell
# no-ops any clone already at its pin and only hits the network when a pin moved.
if [[ -x "$DOTFILES/bin/bootstrap-shell" ]]; then
  log "converging shell framework (oh-my-zsh / p10k / plugins → pins)…"
  "$DOTFILES/bin/bootstrap-shell" || log "WARN: bootstrap-shell reported an issue (continuing)"
fi

if ! command -v stow >/dev/null 2>&1; then
  log "ERROR: stow not found — install it (brew/apt/opkg), or on hosts without"
  log "stow (hyperion) use the manual ln loop in README § non-Mac bootstrap."
  exit 1
fi

log "re-stowing packages…"
# Package selection: the untracked per-host manifest ~/.config/dotfiles/packages
# wins if present (one package per line, # comments allowed) — that's how work
# machines drop ollama and hyperion runs zsh+p10k+git only. The hardcoded list
# below is the fallback default (personal-Mac full set).
PACKAGES=(zsh p10k tmux git nvim lazygit atuin ollama)
PKG_MANIFEST="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/packages"
if [[ -r "$PKG_MANIFEST" ]]; then
  log "using package manifest: $PKG_MANIFEST"
  PACKAGES=()
  while IFS= read -r line; do
    line="${line%%#*}"                  # strip comments
    line="${line//[[:space:]]/}"        # strip whitespace
    [[ -n "$line" ]] && PACKAGES+=("$line")
  done < "$PKG_MANIFEST"
  if (( ${#PACKAGES[@]} == 0 )); then
    log "ERROR: $PKG_MANIFEST exists but lists no packages."
    exit 1
  fi
fi
FAILED=()
for pkg in "${PACKAGES[@]}"; do
  [[ -d "$DOTFILES/$pkg" ]] || continue
  stow --no-folding -R --ignore='\.DS_Store' -d "$DOTFILES" -t "$HOME" "$pkg" \
    || FAILED+=("$pkg")
done

if (( ${#FAILED[@]} )); then
  log "FAILED to stow: ${FAILED[*]} — fix conflicts above and re-run."
  exit 1
fi

log "done."

#!/usr/bin/env bash
# bootstrap-shell — install AND converge the git-cloned shell framework
# (oh-my-zsh, powerlevel10k, zsh-autosuggestions, zsh-syntax-highlighting) to
# the commits pinned in shell-clones.txt. Idempotent; dotfiles-sync runs it on
# every host. Needs only git (works on macOS, Linux, QNAP/Entware).
#
# For each manifest entry: clone if missing; if already at the pin, do nothing
# (no network); otherwise fetch and check out the pin. A clone with local edits
# is left alone with a warning — except hyperion's known QNAP gitstatus patch,
# which is set aside and re-applied by qnap-gitstatus-fix after the checkout.
#
# When powerlevel10k moves, the gitstatus and instant-prompt caches are
# cleared so the new version takes effect.
set -euo pipefail

log()  { printf '\033[36m[bootstrap-shell]\033[0m %s\n' "$*"; }
warn() { printf '\033[33m[bootstrap-shell] WARN:\033[0m %s\n' "$*" >&2; }

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
MANIFEST="${SHELL_CLONES_MANIFEST:-$DOTFILES/shell-clones.txt}"
OMZ="${ZSH:-$HOME/.oh-my-zsh}"
P10K="$OMZ/custom/themes/powerlevel10k"
QNAP_PATCHED_FILE="gitstatus/gitstatus.plugin.zsh"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

command -v git >/dev/null 2>&1 || { warn "git not found — cannot bootstrap shell framework."; exit 1; }
[[ -r "$MANIFEST" ]] || { warn "manifest not found: $MANIFEST"; exit 1; }

P10K_CHANGED=0     # the powerlevel10k checkout moved this run
QNAP_UNPATCHED=0   # we set the QNAP patch aside and must re-apply it

short() { printf '%s' "${1:0:7}"; }
is_dirty() { [[ -n "$(git -C "$1" status --porcelain --untracked-files=no 2>/dev/null)" ]]; }

converge() {   # <dest> <url> <ref>
  local dest="$1" url="$2" ref="$3" name cur
  name="${dest#"$OMZ"/}"; [[ "$name" == "$dest" ]] && name="oh-my-zsh"

  if [[ ! -d "$dest/.git" ]]; then
    log "cloning $url → $name"
    if ! git clone --quiet "$url" "$dest"; then
      warn "$name: clone failed"
      return 0
    fi
    git -C "$dest" checkout --quiet "$ref" 2>/dev/null || warn "$name: cloned but could not check out pin $ref"
    if [[ "$dest" == "$P10K" ]]; then P10K_CHANGED=1; fi
    return 0
  fi

  cur="$(git -C "$dest" rev-parse HEAD 2>/dev/null || echo unknown)"
  if [[ "$cur" == "$ref"* ]]; then
    log "$name: at pin ($(short "$ref"))"
    return 0
  fi

  if [[ "$dest" == "$P10K" && "$(git -C "$dest" diff --name-only HEAD)" == "$QNAP_PATCHED_FILE" ]] \
     && grep -qF 'QNAP-compat' "$dest/$QNAP_PATCHED_FILE"; then
    log "$name: setting the QNAP gitstatus patch aside (re-applied after checkout)"
    git -C "$dest" checkout --quiet -- "$QNAP_PATCHED_FILE"
    QNAP_UNPATCHED=1
  fi
  if is_dirty "$dest"; then
    warn "$name: local changes — leaving it at $(short "$cur") (resolve by hand, then re-run)"
    return 0
  fi

  log "$name: $(short "$cur") → $(short "$ref")"
  # Try fetching just the ref; fall back to a full fetch, then unshallow
  # (hyperion's clones are shallow).
  git -C "$dest" fetch --quiet origin "$ref" 2>/dev/null || git -C "$dest" fetch --quiet --tags origin 2>/dev/null || true
  if ! git -C "$dest" cat-file -e "${ref}^{commit}" 2>/dev/null; then
    git -C "$dest" fetch --quiet --tags --unshallow origin 2>/dev/null || true
  fi
  if git -C "$dest" checkout --quiet "$ref" 2>/dev/null; then
    if [[ "$dest" == "$P10K" ]]; then P10K_CHANGED=1; fi
  else
    warn "$name: could not check out pin $ref (still at $(short "$cur"))"
  fi
}

# Manifest: <subpath under $ZSH, "." for $ZSH itself> <url> <ref>  [# comment]
while IFS= read -r line || [[ -n "$line" ]]; do
  line="${line%%#*}"
  read -r sub url ref _ <<<"$line" || true
  [[ -n "${sub:-}" ]] || continue
  if [[ -z "${url:-}" || -z "${ref:-}" ]]; then
    warn "malformed manifest line (need: <subpath> <url> <ref>): $line"
    continue
  fi
  if [[ "$sub" == "." ]]; then converge "$OMZ" "$url" "$ref"; else converge "$OMZ/$sub" "$url" "$ref"; fi
done < "$MANIFEST"

if (( P10K_CHANGED )); then
  log "powerlevel10k changed — clearing gitstatus + instant-prompt caches"
  cache="${XDG_CACHE_HOME:-$HOME/.cache}"
  rm -rf "$cache/gitstatus"
  rm -f "$cache"/p10k-instant-prompt-*.zsh
fi

# Re-apply the QNAP patch on the host that needs it: wherever we just set it
# aside, or after any p10k move on a non-Mac (only hyperion runs this on Linux;
# dev containers mount the host's clones read-only).
if (( QNAP_UNPATCHED )) || { (( P10K_CHANGED )) && [[ "$(uname -s)" != Darwin ]]; }; then
  if [[ -d "$P10K/gitstatus" ]]; then
    log "re-applying the QNAP gitstatus patch"
    "$SCRIPT_DIR/qnap-gitstatus-fix" || warn "qnap-gitstatus-fix reported a problem"
  fi
fi

log "done."

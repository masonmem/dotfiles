#!/usr/bin/env bash
# bootstrap-shell — install AND converge the git-clone shell framework
# (oh-my-zsh + powerlevel10k + the two zsh plugins) to the versions PINNED in
# shell-clones.txt. Idempotent and safe to re-run.
#
# This is the ONLY install mechanism for these. The brew formulae
# (powerlevel10k, zsh-autosuggestions, zsh-syntax-highlighting) install into
# /opt/homebrew/share and are never wired into oh-my-zsh — .zshrc loads the
# theme and plugins from ~/.oh-my-zsh/custom/, so the git-clone layout is what
# every host (Mac or not) actually uses.
#
# Unlike the old clone-if-missing version, this CONVERGES: for each manifest
# entry it clones when absent, then `git fetch` + checks out the pinned ref so
# an existing STALE clone is brought up to the pin (the exact bug that left
# navi on a 2022 powerlevel10k for four years). A clone with uncommitted local
# edits (e.g. hyperion's QNAP gitstatus patch) is detected and SKIPPED with a
# warning rather than clobbered.
#
# When it actually moves the powerlevel10k ref, it clears the stale
# ~/.cache/gitstatus and ~/.cache/p10k-instant-prompt-*.zsh so the new p10k
# takes effect, and re-runs qnap-gitstatus-fix (if present) to re-apply the
# QNAP setopt-monitor patch.
#
# Usage: bash ~/dotfiles/bin/bootstrap-shell   (or just `bootstrap-shell` once
# ~/dotfiles/bin is on PATH). Works on macOS, Linux, and QNAP/Entware — only
# needs git. POSIX-ish; the only bash-isms are arrays/[[ ]] (bash is present on
# every target host, incl. Entware).
set -euo pipefail

log()  { printf '\033[36m[bootstrap-shell]\033[0m %s\n' "$*"; }
warn() { printf '\033[33m[bootstrap-shell] WARN:\033[0m %s\n' "$*" >&2; }

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
MANIFEST="${SHELL_CLONES_MANIFEST:-$DOTFILES/shell-clones.txt}"
OMZ="${ZSH:-$HOME/.oh-my-zsh}"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

command -v git >/dev/null 2>&1 || { warn "git not found — cannot bootstrap shell framework."; exit 1; }
[ -r "$MANIFEST" ] || { warn "manifest not found: $MANIFEST"; exit 1; }

# Tracks whether the powerlevel10k checkout actually changed this run.
P10K_CHANGED=0

# is_dirty <repo> — true if the working tree has staged or unstaged changes.
is_dirty() {
  ! git -C "$1" diff --quiet HEAD 2>/dev/null || ! git -C "$1" diff --quiet --cached 2>/dev/null
}

# converge <dest> <url> <ref> — clone if missing, else fetch + checkout the pin.
converge() {
  dest="$1"; url="$2"; ref="$3"
  name="${dest#"$OMZ"/}"; [ "$name" = "$dest" ] && name="oh-my-zsh"

  if [ ! -d "$dest/.git" ]; then
    log "cloning $url → $name"
    git clone "$url" "$dest"
    git -C "$dest" checkout --quiet "$ref" 2>/dev/null \
      || warn "$name: cloned but could not check out pin $ref"
    [ "$dest" = "$OMZ/custom/themes/powerlevel10k" ] && P10K_CHANGED=1
    return
  fi

  # Already at the pin? Cheap no-op — don't touch the network.
  cur="$(git -C "$dest" rev-parse HEAD 2>/dev/null || echo unknown)"
  case "$cur" in
    "$ref"*) log "$name: already at pin (${ref%"${ref#???????}"})"; return ;;
  esac

  # Refuse to clobber local edits (hyperion's QNAP gitstatus patch; solaris'
  # extra custom plugins live OUTSIDE these clones so are unaffected).
  if is_dirty "$dest"; then
    warn "$name: working tree dirty — leaving as-is (will not clobber local edits)."
    warn "$name: resolve manually, then re-run. Current HEAD: ${cur%"${cur#???????}"}"
    return
  fi

  log "$name: converging ${cur%"${cur#???????}"} → ${ref%"${ref#???????}"}"
  # Fetch the specific ref. Hyperion's clones are shallow (--depth=1, no tags):
  # try a normal fetch first, deepen/unshallow only if the ref isn't reachable.
  if ! git -C "$dest" fetch --quiet --tags origin "$ref" 2>/dev/null; then
    git -C "$dest" fetch --quiet --tags origin 2>/dev/null || true
  fi
  if ! git -C "$dest" cat-file -e "${ref}^{commit}" 2>/dev/null; then
    log "$name: ref not yet local — unshallowing / deepening fetch"
    git -C "$dest" fetch --quiet --tags --unshallow origin 2>/dev/null \
      || git -C "$dest" fetch --quiet --tags origin 2>/dev/null || true
  fi

  if git -C "$dest" checkout --quiet "$ref" 2>/dev/null; then
    [ "$dest" = "$OMZ/custom/themes/powerlevel10k" ] && P10K_CHANGED=1
  else
    warn "$name: could not check out pin $ref (still at ${cur%"${cur#???????}"})."
  fi
}

# Read the manifest: dest-subpath, url, ref (rest of line after ref is a comment).
while IFS= read -r line || [ -n "$line" ]; do
  line="${line%%#*}"                       # strip comments
  # trim leading/trailing whitespace
  line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  [ -n "$line" ] || continue
  # shellcheck disable=SC2086
  set -- $line
  sub="$1"; url="${2:-}"; ref="${3:-}"
  if [ -z "$url" ] || [ -z "$ref" ]; then
    warn "malformed manifest line (need: <subpath> <url> <ref>): $line"
    continue
  fi
  if [ "$sub" = "." ]; then dest="$OMZ"; else dest="$OMZ/$sub"; fi
  converge "$dest" "$url" "$ref"
done < "$MANIFEST"

# p10k moved → flush stale caches so the new build takes effect, and re-apply
# the QNAP gitstatus patch. Both are no-ops / idempotent when not needed.
if [ "$P10K_CHANGED" -eq 1 ]; then
  log "powerlevel10k ref changed — clearing gitstatus + instant-prompt caches"
  CACHE="${XDG_CACHE_HOME:-$HOME/.cache}"
  rm -rf "$CACHE/gitstatus" 2>/dev/null || true
  rm -f  "$CACHE"/p10k-instant-prompt-*.zsh 2>/dev/null || true
  if [ -x "$SCRIPT_DIR/qnap-gitstatus-fix" ] && [ -d "$OMZ/custom/themes/powerlevel10k/gitstatus" ]; then
    # Only meaningful on QNAP, but the script is idempotent + harmless elsewhere
    # (it only patches if the exact target line is present). Run it where the
    # gitstatus plugin exists so hyperion never loses the setopt-monitor patch.
    if [ "$(uname -s)" != "Darwin" ]; then
      log "re-applying QNAP gitstatus patch (qnap-gitstatus-fix)"
      "$SCRIPT_DIR/qnap-gitstatus-fix" || warn "qnap-gitstatus-fix reported an issue"
    fi
  fi
fi

log "done."

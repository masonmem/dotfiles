#!/usr/bin/env bash
# dexec — run a command inside a running dev container.
#
# Usage:
#   dexec                        interactive login shell (zsh, else bash, else sh)
#   dexec <command> [args...]    run a command
#   dexec -c <container> ...     use a specific container
#   dexec -l                     list running dev containers
#
# Container: $DEXEC_CONTAINER, else the first container with a
# devcontainer.local_folder label, else the first running container whose
# name matches one of $DEXEC_FALLBACKS (substring match).
#
# Environment:
#   DEXEC_CONTAINER   container name/ID to use
#   DEXEC_FALLBACKS   space-separated name patterns (default: "devenv dev-container")
#   DEXEC_WORKDIR     working directory inside the container
#   DEXEC_USER        user inside the container (default: the image's user)
#   DEXEC_SHELL       shell for interactive mode (default: zsh, falling back to bash, sh)
set -euo pipefail

usage() {
  sed -n '2,/^$/s/^# \{0,1\}//p' "$0"
  exit "${1:-0}"
}

list_containers() {
  echo "Running devcontainers:"
  docker ps --filter "label=devcontainer.local_folder" \
    --format '  {{.Names}}\t{{.Label "devcontainer.local_folder"}}'
  local name
  for name in ${DEXEC_FALLBACKS:-devenv dev-container}; do
    docker ps --filter "name=$name" --format '  {{.Names}}\t{{.Status}}'
  done
}

find_container() {
  if [[ -n "${DEXEC_CONTAINER:-}" ]]; then
    echo "$DEXEC_CONTAINER"
    return
  fi
  local found name
  found=$(docker ps -q --filter "label=devcontainer.local_folder" | head -1)
  if [[ -n "$found" ]]; then
    echo "$found"
    return
  fi
  for name in ${DEXEC_FALLBACKS:-devenv dev-container}; do
    found=$(docker ps -q --filter "name=$name" | head -1)
    if [[ -n "$found" ]]; then
      echo "$found"
      return
    fi
  done
}

CONTAINER=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage 0 ;;
    -l|--list) list_containers; exit 0 ;;
    -c|--container) CONTAINER="${2:?-c needs a container name}"; shift 2 ;;
    *) break ;;
  esac
done

[[ -n "$CONTAINER" ]] || CONTAINER=$(find_container)
if [[ -z "$CONTAINER" ]]; then
  echo "Error: no running devcontainer found. Start one or set DEXEC_CONTAINER." >&2
  exit 1
fi
if [[ "$(docker inspect --format '{{.State.Running}}' "$CONTAINER" 2>/dev/null)" != true ]]; then
  echo "Error: container '$CONTAINER' is not running." >&2
  exit 1
fi

# Allocate a TTY only when we have one, so `dexec cmd | less` and scripts work.
EXEC_ARGS=(-i)
[[ -t 0 && -t 1 ]] && EXEC_ARGS+=(-t)
[[ -n "${DEXEC_USER:-}" ]] && EXEC_ARGS+=(-u "$DEXEC_USER")
[[ -n "${DEXEC_WORKDIR:-}" ]] && EXEC_ARGS+=(-w "$DEXEC_WORKDIR")

if [[ $# -eq 0 ]]; then
  # shellcheck disable=SC2016  # expanded by the container's sh
  exec docker exec "${EXEC_ARGS[@]}" "$CONTAINER" sh -c \
    'for s in "$1" zsh bash sh; do command -v "$s" >/dev/null 2>&1 && exec "$s" -l; done' \
    sh "${DEXEC_SHELL:-zsh}"
fi
exec docker exec "${EXEC_ARGS[@]}" "$CONTAINER" "$@"

#!/usr/bin/env bash
# secrets-push — mirror ~/.ai-config/secrets/ to another Mac (over SSH).
# Run after rotating any virtual key, periphery secret, or MCP key. Pushes
# FROM the machine you ran the rotation ON to the named host.
#
# Defaults to `solaris` because that's the always-on box in this setup,
# but any SSH host alias works.
#
# Usage:
#   secrets-push                 # default host (solaris)
#   secrets-push <hostname>      # any other Mac on the tailnet
#
# What it does:
#   - rsync --archive --delete-after the entire ~/.ai-config/secrets tree
#     (~/.copilot/secrets is a symlink into ~/.ai-config/secrets on both
#     ends, so either path works — kept for compatibility)
#   - chmod 600 on the remote side
#   - prints a hash diff so you can sanity-check parity
set -euo pipefail

HOST="${1:-solaris}"
SRC="$HOME/.copilot/secrets/"
DEST=".copilot/secrets/"

echo "→ syncing $SRC → $HOST:$DEST"
rsync -a --delete-after "$SRC" "$HOST:$DEST"
ssh "$HOST" "chmod 700 ~/.copilot/secrets && chmod 600 ~/.copilot/secrets/*"

echo
echo "→ verifying hashes (local vs $HOST):"
diff <(cd "$SRC" && shasum * 2>/dev/null | sort) \
     <(ssh "$HOST" "cd $DEST && shasum * 2>/dev/null | sort") \
  && echo "✓ in sync" || echo "✗ mismatch"

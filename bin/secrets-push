#!/usr/bin/env bash
# secrets-push — sync ~/.copilot/secrets to a remote host (typically solaris).
# These live OUTSIDE git intentionally. This script is the manual mirror
# command — run after rotating any virtual key, periphery secret, MCP key.
#
# Usage:
#   secrets-push [host]      # default: solaris
#
# What it does:
#   - rsync --archive --delete-after the entire ~/.copilot/secrets tree
#   - chmod 600 on the remote side
#   - prints a hash diff so you can sanity-check parity
set -euo pipefail

HOST="${1:-solaris}"
SRC="$HOME/.copilot/secrets/"
DEST=".copilot/secrets/"

echo "→ syncing $SRC → $HOST:$DEST"
rsync -a --delete-after "$SRC" "$HOST:$DEST"
ssh "$HOST" "chmod 700 ~/.copilot/secrets && chmod 600 ~/.copilot/secrets/*"

echo
echo "→ verifying hashes (local vs $HOST):"
diff <(cd "$SRC" && shasum * 2>/dev/null | sort) \
     <(ssh "$HOST" "cd $DEST && shasum * 2>/dev/null | sort") \
  && echo "✓ in sync" || echo "✗ mismatch"

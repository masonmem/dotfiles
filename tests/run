#!/usr/bin/env bash
# tests/run — every check for this repo. The pre-push hook (.githooks/pre-push)
# runs it with --offline before each push, since `sync-all` spreads a mistake
# to every machine. There is no hosted CI.
#
#   tests/run            all checks
#   tests/run --offline  skip test-shell-startup.sh (it clones from GitHub)
#
# A check whose tool isn't installed is skipped with a note, not failed, so the
# hook also works on minimal hosts. On a Mac with the Brewfile, nothing skips.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

failed=()
skipped=()
have() { command -v "$1" >/dev/null 2>&1; }
skip() { printf '\n\033[1m▷ %s\033[0m — skipped (%s)\n' "$1" "$2"; skipped+=("$1"); }
step() {   # <name> <command...>
  printf '\n\033[1m▶ %s\033[0m\n' "$1"
  if "${@:2}"; then echo "✓ $1"; else echo "✗ $1"; failed+=("$1"); fi
}

bash_scripts=(install.sh .githooks/pre-push bin/bootstrap-shell bin/dexec bin/dotfiles-docs bin/dotfiles-sync bin/qnap-gitstatus-fix bin/sync-all
              ollama/bin/litellm-keys ollama/bin/install-ollama.sh scripts/devcontainer-tools.sh tests/run tests/*.sh)
zsh_files=(zsh/.zshenv zsh/.zprofile zsh/.zshrc zsh/.config/zsh/*.zsh */.config/zsh/*.zsh templates/zsh-host.zsh tests/*.zsh)

zsh_syntax() { local f; for f in "$@"; do zsh -n "$f" || return 1; done; }

if have shellcheck; then step "shellcheck" shellcheck "${bash_scripts[@]}"; else skip "shellcheck" "brew install shellcheck"; fi
if have zsh; then
  step "zsh syntax"       zsh_syntax "${zsh_files[@]}"
  step "zsh alias policy" zsh tests/test-zsh-aliases.zsh
else
  skip "zsh checks" "zsh not installed"
fi
step "configure-vscode-ai" python3 -m unittest -q tests/test-configure-vscode-ai.py
step "brew output visible" python3 -m unittest -q tests/test-dotfiles-sync.py
step "dotfiles-sync"      tests/test-dotfiles-sync.sh
if [[ "${1:-}" == --offline ]]; then
  skip "shell startup" "--offline"
elif have stow && have zsh; then
  step "shell startup" tests/test-shell-startup.sh
else
  skip "shell startup" "needs stow and zsh"
fi
# Docs: prefer uvx (pinned versions from docs/requirements.txt, throwaway env).
docs_out="$(mktemp -d)"
export NO_MKDOCS_2_WARNING=1  # Material 9.7's MkDocs 2.0 banner; the pins avoid 2.0
if have uvx; then
  step "docs build (strict)" uvx --quiet --with-requirements docs/requirements.txt mkdocs build --strict --quiet --site-dir "$docs_out"
elif have mkdocs; then
  step "docs build (strict)" mkdocs build --strict --quiet --site-dir "$docs_out"
else
  skip "docs build" "brew install uv"
fi
rm -rf "$docs_out"

echo
if (( ${#skipped[@]} )); then echo "Skipped: ${skipped[*]}"; fi
if (( ${#failed[@]} )); then echo "FAILED: ${failed[*]}"; exit 1; fi
echo "All checks passed."

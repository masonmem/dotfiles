#!/usr/bin/env bash
# pre-push — run the repo's checks on this machine before anything is pushed,
# because `sync-all` spreads a mistake to every other machine. There is no
# hosted CI; this hook is the gate.
#
# Enabled per clone by dotfiles-sync (git config core.hooksPath .githooks).
# Skip once, deliberately:  git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
echo "[pre-push] tests/run --offline   (skip once with: git push --no-verify)"
exec tests/run --offline

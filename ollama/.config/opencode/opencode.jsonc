{
  // opencode config (stowed from ~/dotfiles/ollama).
  //
  // Routes through the LiteLLM gateway on solaris
  // (https://llm.hyperionx.dev) using the per-tool virtual key exported
  // by 16-llm-gateway.zsh as $OPENCODE_LITELLM_KEY (sourced from
  // ~/.copilot/secrets/litellm-opencode.txt).
  //
  // Model names follow LiteLLM's `local/*` namespace
  // (homelab/solaris/litellm/config.yaml). Add a new model: pull on
  // solaris with `ollama pull <name>`, add an entry in config.yaml, then
  // mirror it here.
  //
  // Why granite4.1:8b is the default (May 2026): in a Copilot CLI bench
  // against gemma4:e4b-tools and qwen3.5:4b, only granite4.1:8b made
  // clean tool calls (glob/view) instead of inventing tool names. IBM
  // Apache-2.0, ~5 GB, OpenAI-style tool schemas.
  //
  // Temperature: 0.2 across the board — Ollama's 0.6–0.7 default is too
  // high for stable tool calling.
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM (solaris gateway)",
      "options": {
        "baseURL": "https://llm.hyperionx.dev/v1",
        "apiKey": "{env:OPENCODE_LITELLM_KEY}"
      },
      "models": {
        "local/granite4.1-8b": {
          "name": "Granite 4.1 8B (default; cleanest agentic tool calls)",
          "tools": true,
          "options": { "temperature": 0.2 }
        },
        "local/gemma4-e4b": {
          "name": "Gemma 4 E4B (chat/code; multimodal, 256K ctx)",
          "tools": true,
          "options": { "temperature": 0.2, "reasoning_effort": "none" }
        },
        "local/qwen2.5-coder-7b": {
          "name": "Qwen2.5 Coder 7B (no thinking mode)",
          "tools": true,
          "options": { "temperature": 0.2 }
        },
        "local/qwen3-14b": {
          "name": "Qwen3 14B (smarter, slow)",
          "tools": true,
          "options": { "temperature": 0.4 }
        },
        "local/deepseek-r1-14b": {
          "name": "DeepSeek R1 14B (reasoning)",
          "tools": true,
          "options": { "temperature": 0.4 }
        },
        "local/llama3.2-vision-11b": {
          "name": "Llama 3.2 Vision 11B (multimodal)",
          "tools": true,
          "options": { "temperature": 0.3 }
        },
        "local/dolphin3-8b": {
          "name": "Dolphin 3 8B (uncensored chat)",
          "tools": true,
          "options": { "temperature": 0.4 }
        }
      }
    }
  },
  "model": "litellm/local/granite4.1-8b",
  "small_model": "litellm/local/granite4.1-8b"
}

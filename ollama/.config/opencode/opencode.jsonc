{
  // opencode config (stowed from ~/dotfiles/ollama).
  //
  // Single source of truth: the LiteLLM gateway on solaris
  // (https://llm.hyperionx.dev). Authenticated with the per-tool
  // virtual key $OPENCODE_LITELLM_KEY (exported by 16-llm-gateway.zsh
  // from ~/.copilot/secrets/litellm-opencode.txt).
  //
  // Model names mirror homelab/solaris/litellm/config.yaml:
  //   • `local/*` — ollama models on solaris
  //   • `cloud/*` — BYOK providers (currently Anthropic only)
  //
  // To add a model:
  //   1. (local) `ollama pull <name>` on solaris, add to litellm config.yaml.
  //   2. (cloud) add a model_list entry + provider key in periphery secrets.
  //   3. Add a matching entry below so it shows up in the picker.
  //
  // `enabled_providers` is an allowlist — without it, opencode would
  // auto-detect every provider whose env var is set (OPENAI_API_KEY,
  // ANTHROPIC_API_KEY, …) and clutter the picker with hundreds of
  // models we don't host. See:
  // https://github.com/sst/opencode — provider/provider.ts.
  //
  // Default model: granite4.1-8b — in a Copilot CLI bench it made the
  // cleanest tool calls (glob/view) vs gemma4:e4b-tools and qwen3.5:4b.
  // For non-local: switch to cloud/sonnet via `/models` in the TUI.
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["litellm"],
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM (solaris gateway)",
      "options": {
        "baseURL": "https://llm.hyperionx.dev/v1",
        "apiKey": "{env:OPENCODE_LITELLM_KEY}"
      },
      "models": {
        "cloud/sonnet": {
          "name": "Claude Sonnet 4.5 (cloud, BYOK)",
          "tools": true
        },
        "cloud/opus": {
          "name": "Claude Opus 4.5 (cloud, BYOK)",
          "tools": true
        },
        "local/granite4.1-8b": {
          "name": "Granite 4.1 8B (local default; cleanest tool calls)",
          "tools": true,
          "options": { "temperature": 0.2 }
        },
        "local/gemma4-e4b": {
          "name": "Gemma 4 E4B (local; multimodal, 256K ctx)",
          "tools": true,
          "options": { "temperature": 0.2, "reasoning_effort": "none" }
        },
        "local/qwen2.5-coder-7b": {
          "name": "Qwen2.5 Coder 7B (local; no thinking mode)",
          "tools": true,
          "options": { "temperature": 0.2 }
        },
        "local/qwen3-14b": {
          "name": "Qwen3 14B (local; smarter, slow)",
          "tools": true,
          "options": { "temperature": 0.4 }
        },
        "local/qwen3-abliterated-8b": {
          "name": "Qwen3 8B Abliterated (local; uncensored)",
          "tools": true,
          "options": { "temperature": 0.4 }
        },
        "local/deepseek-r1-14b": {
          "name": "DeepSeek R1 14B (local; reasoning)",
          "tools": true,
          "options": { "temperature": 0.4 }
        },
        "local/llama3.2-vision-11b": {
          "name": "Llama 3.2 Vision 11B (local; multimodal)",
          "tools": true,
          "options": { "temperature": 0.3 }
        },
        "local/dolphin3-8b": {
          "name": "Dolphin 3 8B (local; uncensored chat)",
          "tools": true,
          "options": { "temperature": 0.4 }
        }
      }
    }
  },
  "model": "litellm/local/granite4.1-8b",
  "small_model": "litellm/local/granite4.1-8b"
}

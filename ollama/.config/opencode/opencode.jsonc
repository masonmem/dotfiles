{
  // opencode config (stowed from ~/dotfiles/ollama).
  //
  // Single source of truth: the LiteLLM gateway on solaris
  // (https://llm.hyperionx.dev). Authenticated with the per-tool
  // virtual key in ~/.copilot/secrets/litellm-opencode.txt, read
  // directly via opencode's `{file:...}` substitution at config-load
  // time. We deliberately do NOT use `{env:OPENCODE_LITELLM_KEY}`:
  // that returns empty-string when the var is missing from the
  // launching process env (regex replace with `|| ""`), which silently
  // produces 401s if opencode was launched from any context that
  // didn't run 16-llm-gateway.zsh (launchctl, a fresh PATH-only shell,
  // a different terminal app, etc.). `{file:}` decouples auth from
  // shell-env state — same file, no inheritance gotcha.
  //
  // Model ids mirror homelab/solaris/litellm/config.yaml. The id IS
  // the display name — no `name` override here — so opencode and Open
  // WebUI show identical strings (e.g. `cloud/claude-sonnet-4.6-3x`). The
  // `-Nx` suffix is the cost tier baked into the id; see
  // homelab/docs/models.md § "Cost-tier suffix".
  //
  // To add a model: add it to litellm/config.yaml first with the
  // `-Nx` suffix, then add a matching entry below (no `name` field).
  //
  // `enabled_providers` is an allowlist — without it, opencode would
  // auto-detect every provider whose env var is set (OPENAI_API_KEY,
  // ANTHROPIC_API_KEY, …) and clutter the picker with hundreds of
  // models we don't host.
  //
  // Default model: `auto` — LiteLLM's auto alias defaults to local
  // granite and auto-escalates to cloud sonnet on context overflow.
  // Switch to a pinned model via `/models` in the TUI.
  //
  // MCP servers (`mcp` block) extend opencode with tools. Conventions:
  //   - install via official npm packages where they exist
  //   - secrets come via env vars exported from ~/.copilot/secrets/
  //   - filesystem is scoped to ~/code and ~/notes (drop a path to deny it)
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["litellm"],
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM (solaris gateway)",
      "options": {
        "baseURL": "https://llm.hyperionx.dev/v1",
        "apiKey": "{file:~/.copilot/secrets/litellm-opencode.txt}"
      },
      "models": {
        "auto":                      { "tools": true },
        "smart":                     { "tools": true },
        "cloud/claude-opus-4.7-5x":         { "tools": true },
        "cloud/claude-opus-4.6-5x":         { "tools": true },
        "cloud/claude-sonnet-4.6-3x":       { "tools": true },
        "cloud/claude-haiku-4.5-1x":        { "tools": true },
        "cloud/gemini-flash-2.5-1x":        { "tools": true },
        "local/granite4.1-8b-0x":    { "tools": true, "options": { "temperature": 0.2, "top_p": 0.9, "top_k": 40 } },
        "local/gemma4-e4b-0x":       { "tools": true, "options": { "temperature": 1.0, "top_p": 0.95, "top_k": 64, "reasoning_effort": "none" } },
        // qwen2.5-coder advertises `tools` capability but its native tool
        // template is unreliable — it emits raw `{"name":...,"arguments":...}`
        // JSON as content even at the /api/chat layer. Mark tools:false so
        // opencode doesn't try to drive it as an agent loop.
        "local/qwen2.5-coder-7b-0x": { "tools": false, "options": { "temperature": 0.1, "top_p": 0.9, "top_k": 20 } },
        "local/qwen3-14b-0x":        { "tools": true,  "options": { "temperature": 0.6, "top_p": 0.95, "top_k": 20 } },
        "local/qwen3-abliterated-8b-0x": { "tools": true, "options": { "temperature": 0.7, "top_p": 0.8, "top_k": 20 } },
        // Models below have NO `tools` capability per `ollama show`. Sending
        // tools to them just embeds the schema in the prompt and the model
        // emits raw JSON text (looks like the LiteLLM streaming-tools bug
        // but is actually the model lacking native tool support).
        "local/deepseek-r1-14b-0x":  { "tools": false, "options": { "temperature": 0.6, "top_p": 0.95 } },
        "local/llama3.2-vision-11b-0x": { "tools": false, "options": { "temperature": 0.3, "top_p": 0.9 } },
        "local/dolphin3-8b-0x":      { "tools": false, "options": { "temperature": 0.7, "top_p": 0.9, "top_k": 40 } }
      }
    }
  },
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "{env:HOME}/code", "{env:HOME}/notes"],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": ["uvx", "mcp-server-fetch"],
      "enabled": true
    },
    "github": {
      // Deprecated upstream — @modelcontextprotocol/server-github is no
      // longer maintained. The `gh` CLI is already authenticated and on
      // PATH; opencode can call it via bash for the same surface
      // (issues, PRs, repo queries). Re-enable with the new official
      // `github/github-mcp-server` (Go binary) when a stable npm/brew
      // distribution lands and we wire GITHUB_TOKEN.
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": { "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}" },
      "enabled": false
    },
    // Persistent knowledge graph across opencode sessions. Stores
    // entities, relations, and observations to ~/.config/opencode/
    // memory.json by default. Lets the model remember "Mason prefers X"
    // across runs without re-explaining every time.
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    },
    // Date/time/timezone math. Tiny but fixes the "model thinks it's
    // 2024" class of bug; useful any time the model needs to reason
    // about "today", "in 3 days", or convert across zones.
    "time": {
      "type": "local",
      "command": ["uvx", "mcp-server-time"],
      "enabled": true
    },
    // Structured reasoning scratchpad. The model can call this to lay
    // out and revise a multi-step plan before executing. Useful in long
    // agent loops; ~free when not called.
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    }
  },
  "model": "litellm/auto",
  "small_model": "litellm/local/granite4.1-8b-0x",

  // ---------------------------------------------------------------
  // Agent-plane permission gate (SKILL.md rule 17).
  // opencode is the WRITE side of the chat/agent split: it gets bash,
  // write, edit, and shell-driven git mutation. Those are gated to
  // require approval so that anything injected into a prompt (notes,
  // pasted issue body, fetched page, MCP tool output) can't silently
  // mutate state. Read-class tools (read, grep/glob, list) stay on
  // "allow" — they're the same surface the chat plane has.
  // ---------------------------------------------------------------
  "permission": {
    "edit": "ask",
    "write": "ask",
    "bash": {
      // Read-class shell — safe to auto-allow.
      "ls *":      "allow",
      "cat *":     "allow",
      "head *":    "allow",
      "tail *":    "allow",
      "rg *":      "allow",
      "grep *":    "allow",
      "fd *":      "allow",
      "find *":    "allow",
      "tree *":    "allow",
      "pwd":       "allow",
      "echo *":    "allow",
      "wc *":      "allow",
      "git status*":   "allow",
      "git log*":      "allow",
      "git diff*":     "allow",
      "git show*":     "allow",
      "git branch*":   "allow",
      "git remote*":   "allow",
      // Anything else (rm, mv, git push, npm/pip install, docker, kubectl,
      // curl/wget that could exfil, eval, sudo, …) requires approval.
      "*": "ask"
    }
  }
}

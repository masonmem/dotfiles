{
  // opencode config (stowed from ~/dotfiles/ollama).
  //
  // Single source of truth: the LiteLLM gateway on solaris
  // (https://llm.hyperionx.dev). Authenticated with the per-tool
  // virtual key $OPENCODE_LITELLM_KEY (exported by 16-llm-gateway.zsh
  // from ~/.copilot/secrets/litellm-opencode.txt).
  //
  // Model ids mirror homelab/solaris/litellm/config.yaml. The id IS
  // the display name — no `name` override here — so opencode and Open
  // WebUI show identical strings (e.g. `cloud/sonnet-4.5-3x`). The
  // `-Nx` suffix is the cost tier baked into the id; see
  // homelab/docs/models.md § "Cost-tier suffix".
  //
  // To add a model: add it to litellm/config.yaml first with the
  // `-Nx` suffix, then add a matching entry below (no `name` field).
  //
  // `enabled_providers` is an allowlist — without it, opencode would
  // auto-detect every provider whose env var is set (OPENAI_API_KEY,
  // ANTHROPIC_API_KEY, …) and clutter the picker with hundreds of
  // models we don't host.
  //
  // Default model: granite4.1-8b — in a Copilot CLI bench it made the
  // cleanest tool calls vs gemma4:e4b-tools and qwen3.5:4b. For non-
  // local: switch to cloud/sonnet-4.5-3x via `/models` in the TUI.
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["litellm"],
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM (solaris gateway)",
      "options": {
        "baseURL": "https://llm.hyperionx.dev/v1",
        "apiKey": "{env:OPENCODE_LITELLM_KEY}"
      },
      "models": {
        "cloud/opus-4.5-15x":        { "tools": true },
        "cloud/sonnet-4.5-3x":       { "tools": true },
        "cloud/haiku-4.5-1x":        { "tools": true },
        "local/granite4.1-8b-0x":    { "tools": true, "options": { "temperature": 0.2 } },
        "local/gemma4-e4b-0x":       { "tools": true, "options": { "temperature": 0.2, "reasoning_effort": "none" } },
        "local/qwen2.5-coder-7b-0x": { "tools": true, "options": { "temperature": 0.2 } },
        "local/qwen3-14b-0x":        { "tools": true, "options": { "temperature": 0.4 } },
        "local/qwen3-abliterated-8b-0x": { "tools": true, "options": { "temperature": 0.4 } },
        "local/deepseek-r1-14b-0x":  { "tools": true, "options": { "temperature": 0.4 } },
        "local/llama3.2-vision-11b-0x": { "tools": true, "options": { "temperature": 0.3 } },
        "local/dolphin3-8b-0x":      { "tools": true, "options": { "temperature": 0.4 } }
      }
    }
  },
  "model": "litellm/local/granite4.1-8b-0x",
  "small_model": "litellm/local/granite4.1-8b-0x"
}

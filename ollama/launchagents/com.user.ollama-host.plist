<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Host/bind config for Ollama. Sister to com.user.ollama-env.plist (which
  sets tuning params). Kept separate so the bind address can vary per host
  without touching the shared tuning plist.

  OLLAMA_HOST=0.0.0.0:11434 binds all interfaces, so:
    - Docker Desktop containers reach it via host.docker.internal:11434
    - Tailnet peers reach it via the tailnet IP
    - Local CLI (e.g. `ollama list`) reaches it via 127.0.0.1
  No other binding (loopback-only or tailnet-only) satisfies all three at
  once.

  OLLAMA_MODELS points at the external SSD where the models live (52G
  of `local/*-0x` tags). Adjust per host if you don't have a Helio
  drive mounted.

  Self-healing: WatchPaths fires whenever /Volumes/Helio is mounted
  or unmounted. RunAtLoad fires once at user login. The /usr/bin/test
  gate inside the script ensures we only setenv + restart ollama when
  the models dir is actually present (avoids ollama coming up against
  the empty default ~/.ollama/models and silently serving zero models).

  KeepAlive is intentionally NOT used: this is a one-shot env-poker,
  not a long-running daemon. KeepAlive=true would respawn the script
  every ~10s under throttling.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.user.ollama-host</string>
  <key>RunAtLoad</key>
  <true/>
  <key>WatchPaths</key>
  <array>
    <string>/Volumes/Helio</string>
  </array>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>
      if [ ! -d /Volumes/Helio/ollama/models ]; then exit 0; fi;
      /bin/launchctl setenv OLLAMA_HOST 0.0.0.0:11434;
      /bin/launchctl setenv OLLAMA_MODELS /Volumes/Helio/ollama/models;
      current="$(/usr/bin/pgrep -x ollama | /usr/bin/head -1)";
      if [ -n "$current" ]; then
        env_models="$(/bin/ps -E -p "$current" 2>/dev/null | /usr/bin/tr ' ' '\n' | /usr/bin/grep '^OLLAMA_MODELS=' | /usr/bin/cut -d= -f2-)";
        if [ "$env_models" != "/Volumes/Helio/ollama/models" ]; then
          /opt/homebrew/bin/brew services restart ollama >/dev/null 2>&1 || true;
        fi;
      fi;
      exit 0;
    </string>
  </array>
</dict>
</plist>
